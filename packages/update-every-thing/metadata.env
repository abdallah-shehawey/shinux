PKG_NAME="update-every-thing"
PKG_VERSION="1.1.0"
PKG_RELEASE="1"
# dnf, fwupd and flatpak: this one is Fedora-shaped, so no .deb is built.
PKG_FORMATS="rpm"
PKG_SUMMARY="Run every Fedora update in one pass, with a summary"
PKG_DESCRIPTION="Updates system packages, firmware, Flatpaks and the Antigravity IDE in an order that refreshes repository metadata only once, then prints one summary of what succeeded, failed or was skipped. A failing step is retried a bounded number of times and then given up on, so the run always reaches the end. NVIDIA packages are excluded unless asked for."
PKG_LICENSE="MIT"
PKG_SECTION="admin"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash sudo coreutils"
RPM_RECOMMENDS="fwupd flatpak antigravity-update"
