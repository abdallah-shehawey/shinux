PKG_NAME="update-every-thing"
PKG_VERSION="2.2.1"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Run every system update in one pass, with a summary"
PKG_DESCRIPTION="Detects dnf, yum or apt and runs the right update commands for that system, then firmware, Flatpak and Snap, and prints one summary of what succeeded, failed or was skipped. A failing step is retried a bounded number of times and then given up on, so the run always reaches the end. NVIDIA packages are held back unless asked for, and any hold this run adds is released again even if you interrupt it."
PKG_LICENSE="MIT"
PKG_SECTION="admin"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash sudo coreutils"
RPM_RECOMMENDS="fwupd flatpak antigravity-update"
DEB_DEPENDS="bash, sudo, coreutils"
DEB_RECOMMENDS="fwupd, flatpak, antigravity-update"
