PKG_NAME="shinux-scripts"
PKG_VERSION="1.0.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Every command from the Shinux repository, in one install"
PKG_DESCRIPTION="A metapackage that pulls in every command published in the Shinux repository. It contains no files of its own: install it to get the lot, or install the individual packages if you only want some of them. Removing it leaves the commands installed; remove them by name."
PKG_LICENSE="MIT"
PKG_SECTION="metapackages"
RPM_ARCH="noarch"
DEB_ARCH="all"
# update-every-thing is Fedora-only, so it appears in the rpm list alone.
RPM_REQUIRES="vidtime padnum meet hashnum dlup antigravity-update update-every-thing"
DEB_DEPENDS="vidtime, padnum, meet, hashnum, dlup, antigravity-update"
