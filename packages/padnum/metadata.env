PKG_NAME="padnum"
PKG_VERSION="1.3.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb arch"
PKG_SUMMARY="Zero-pad the numeric prefix of filenames, with undo"
PKG_DESCRIPTION="Renames the files in the current or target directory so their leading numbers share a width, turning 1, 2, ... 10 into 01, 02, ... 10 so they sort correctly. The rest of each name is preserved byte for byte, including Arabic text and spaces. Supports target directory, a dry run, a chosen separator, an extension filter and multi-level undo."
PKG_LICENSE="MIT"
PKG_SECTION="utils"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash coreutils sed /usr/bin/awk less"
DEB_DEPENDS="bash, coreutils, sed, gawk | mawk, less"
ARCH_ARCH="any"
ARCH_DEPENDS="bash coreutils sed gawk less"
