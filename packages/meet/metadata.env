PKG_NAME="meet"
PKG_VERSION="1.2.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb arch"
PKG_SUMMARY="Open a saved meeting link by name"
PKG_DESCRIPTION="Keeps a short list of meeting URLs under names you choose, so a recurring call is 'meet standup' rather than a bookmark hunt. With no arguments it offers a picker, using fzf when available and a plain numbered menu otherwise. Any URL works; nothing about it is Google-specific."
PKG_LICENSE="MIT"
PKG_SECTION="utils"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash /usr/bin/awk xdg-utils"
RPM_RECOMMENDS="fzf"
DEB_DEPENDS="bash, gawk | mawk, xdg-utils"
DEB_RECOMMENDS="fzf"
ARCH_ARCH="any"
ARCH_DEPENDS="bash gawk xdg-utils"
ARCH_OPTDEPENDS="fzf: fuzzy meeting selection"
