PKG_NAME="dlup"
PKG_VERSION="1.1.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Download media with yt-dlp and push it straight to an rclone remote"
PKG_DESCRIPTION="Downloads each URL with yt-dlp into its own staging directory, uploads it to an rclone remote, and deletes the local copy before moving on, so a long list of recordings never fills the disk. Reads URLs from arguments or a commented list file, supports cookie files for sites that need a signed-in session, and keeps going when one URL fails."
PKG_LICENSE="MIT"
PKG_SECTION="net"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash yt-dlp rclone coreutils"
DEB_DEPENDS="bash, yt-dlp, rclone, coreutils"
