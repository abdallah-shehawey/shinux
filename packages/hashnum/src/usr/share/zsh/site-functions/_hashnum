#compdef hashnum
# zsh completion for hashnum

_hashnum() {
  _arguments -s -S \
    '(-n --dry-run)'{-n,--dry-run}'[show what would be renamed]' \
    '(-q --quiet)'{-q,--quiet}'[print nothing except errors]' \
    '(- *)'{-V,--version}'[print version and exit]' \
    '(- *)'{-h,--help}'[show help and exit]' \
    '*:file:_files'
}

_hashnum "$@"
