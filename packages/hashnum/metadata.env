PKG_NAME="hashnum"
PKG_VERSION="1.0.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Move a #N tag to the front of a filename"
PKG_DESCRIPTION="Turns 'Some Long Title #12.mp4' into '#12 Some Long Title.mp4', so a directory of exports sorts by number instead of by title. Tidies the whitespace the moved tag leaves behind, skips files without a tag, and never overwrites an existing name. Pairs with padnum for zero-padding."
PKG_LICENSE="MIT"
PKG_SECTION="utils"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash coreutils"
DEB_DEPENDS="bash, coreutils"
RPM_SUGGESTS="padnum"
DEB_SUGGESTS="padnum"
