PKG_NAME="whatsapp"
PKG_VERSION="1.0.11"
PKG_RELEASE="3"
PKG_FORMATS="rpm deb arch"
PKG_SUMMARY="A small WhatsApp Web client for GTK4 and WebKitGTK 6"
PKG_URL="https://github.com/abdallah-shehawey/whatsapp"
PKG_DESCRIPTION="Loads web.whatsapp.com in a GTK4 window, so it is the client WhatsApp itself serves to a browser rather than a reimplemented protocol. Fixes what the other Linux clients get wrong: image paste, which WebKitGTK breaks by handing the page an empty clipboardData; the user agent, which WebKitGTK's site-specific quirks rewrite until WhatsApp believes it is Safari on a Mac; emoji, which are sprite sheets that nothing on the machine was keeping, so 4.7 MB of them came down again on every single launch and the panel sat full of blank squares until it finished -- they are kept on disk now and drawn offline; and notifications, which arrive one per message, name the sender, quote the message, carry the contact's picture and ring. Each banner comes down on the client's own clock -- GNOME leaves one up until the pointer moves off it, and while it is up it queues three more and drops the rest in silence -- and the message it carried stays in the notification centre afterwards, one entry per message even when several arrive at once. Arabic reads properly, where WhatsApp's own line boxes are too short for the glyphs WebKit falls back to and clip the tail off every final noon and yeh. Links open in the desktop browser instead of doing nothing. A message that lands in the chat already on screen plays its tone without raising a banner over it. Starts hidden at login into the system tray, marks the tray icon unread without drawing a number on anything, and follows the desktop's dark mode and interface font."
PKG_LICENSE="GPL-3.0-or-later"
PKG_SECTION="net"
RPM_ARCH="x86_64"
DEB_ARCH="amd64"
RPM_REQUIRES="webkitgtk6.0 gtk4 glib2 hicolor-icon-theme"
DEB_DEPENDS="libwebkitgtk-6.0-4, libgtk-4-1, libglib2.0-0, hicolor-icon-theme"
ARCH_ARCH="x86_64"
ARCH_DEPENDS="gtk4 webkitgtk-6.0 glib2 hicolor-icon-theme"
