PKG_NAME="vidtime"
PKG_VERSION="1.1.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Print how long media files run, and their total"
PKG_DESCRIPTION="Reads the duration of each file with ffprobe and prints it as HH:MM:SS, followed by the total. Handles whole directories with -r, prints a bare total with -t for scripting, and keeps going when one file turns out not to be media."
PKG_LICENSE="MIT"
PKG_SECTION="video"
RPM_ARCH="noarch"
DEB_ARCH="all"
# A file dependency rather than a package name: ffprobe ships in ffmpeg-free on
# Fedora and in ffmpeg from RPM Fusion, and either one satisfies this.
RPM_REQUIRES="bash /usr/bin/ffprobe"
DEB_DEPENDS="bash, ffmpeg"
