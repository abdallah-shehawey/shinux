# Per-package metadata. Sourced by both the RPM and the DEB build.
PKG_NAME="hello-shinux"
PKG_VERSION="1.0.0"
PKG_RELEASE="1"
PKG_SUMMARY="Demo package shipped from the Shinux repository"
PKG_DESCRIPTION="A tiny shell utility that prints a greeting. It exists to verify that adding the Shinux repository and installing from it works on both dnf- and apt-based systems."
PKG_LICENSE="MIT"
PKG_SECTION="utils"
# Runtime dependencies, in each packager's own syntax.
RPM_REQUIRES="bash"
DEB_DEPENDS="bash"
# noarch/all for scripts, x86_64/amd64 for compiled binaries.
RPM_ARCH="noarch"
DEB_ARCH="all"
