PKG_NAME="whatsapp-desktop"
PKG_VERSION="1.6.6"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb arch"
PKG_SUMMARY="WhatsApp Web in a window of its own, on Chromium with calls, screen sharing, theme switcher, and settings"
PKG_DESCRIPTION="Loads web.whatsapp.com in a Chromium window with full voice and video call support including screen sharing during calls, built-in Settings dialog, and dark/light theme switching. It draws the whole page in the desktop's own font, read from GSettings and applied as a user stylesheet, which is the one level whose rules beat the page's own. It lives in the system tray: closing the window leaves the client connected and messages still arriving, and it can start hidden at login with an easy autostart toggle. Notifications arrive one per message, name the sender, quote the message and carry the contact's picture, and clicking one brings the window back and opens the conversation it came from. Each banner comes down on the client's own clock -- GNOME leaves one up until the pointer moves off it, and while it is up it queues three more and drops the rest in silence -- and the message it carried stays in the notification centre afterwards. A message that lands in the chat already on screen plays its tone without raising a banner over it, and neither a typing indicator nor a message sent from the phone raises anything at all. Arabic is given the room WhatsApp's own line boxes do not leave for its descenders. Full WebRTC microphone and camera support for clear voice and video calls, and screen sharing via desktopCapturer with PipeWire support for Wayland. Links open in the desktop browser, downloads land in ~/Downloads, and the client follows the desktop's dark mode and interface font as they change. Ships its own copy of Electron, so it depends on no browser being installed."
PKG_LICENSE="GPL-3.0-or-later"
PKG_SECTION="net"
RPM_ARCH="x86_64"
DEB_ARCH="amd64"

# Electron is 194 MB in one file, past what GitHub accepts in a push, so src/
# is git-ignored and staged by refresh.sh instead. Naming the script here is
# what stops scripts/build.sh shipping an empty package from a fresh checkout.
PKG_SRC_GENERATED="packages/whatsapp-desktop/refresh.sh"

# rpm generates the library dependencies itself from the ELF files, so only what
# it cannot see is listed here.
RPM_REQUIRES="hicolor-icon-theme"

# The bundled Chromium libraries live in a private directory and are nobody
# else's to depend on: without the first line, this package would advertise
# Provides: libvulkan.so.1 and libEGL.so to the whole system, and dnf could
# satisfy another package's dependency with a copy meant only for this app. The
# second line is the other half of that -- the electron binary genuinely does
# require those SONAMEs, and once they stop being provided the package cannot
# install itself.
RPM_GLOBALS="__os_install_post %{nil}
__provides_exclude_from ^/usr/lib/whatsapp-desktop/.*$
__requires_exclude ^(libffmpeg|libEGL|libGLESv2|libvk_swiftshader|libvulkan)\\.so.*$"

RPM_FILES="/usr/bin/whatsapp-desktop
/usr/lib/whatsapp-desktop
%config(noreplace) /etc/xdg/autostart/io.github.shehawey.whatsapp-desktop.desktop
/usr/share/applications/io.github.shehawey.whatsapp-desktop.desktop
/usr/share/icons/hicolor/*/apps/*.png
/usr/share/icons/hicolor/*/status/*.png"

# dpkg does not read ELF files, so every one of these has to be named. The
# pre-t64 names are used deliberately: on Ubuntu 24.04 the t64 packages Provide
# them, so one list covers both sides of that transition.
DEB_DEPENDS="libgtk-3-0, libnss3, libnspr4, libasound2, libcups2, libdrm2, libgbm1, libxkbcommon0, libatk1.0-0, libatk-bridge2.0-0, libatspi2.0-0, libx11-6, libxcomposite1, libxdamage1, libxext6, libxfixes3, libxrandr2, libxi6, libxcursor1, libxinerama1, libwayland-client0, libwayland-cursor0, libwayland-egl1, libpango-1.0-0, libcairo2, libgdk-pixbuf-2.0-0, libfontconfig1, libfreetype6, libexpat1, libdbus-1-3, libglib2.0-0, hicolor-icon-theme, xdg-utils"
# libsecret is dlopened for the password store, and Chromium falls back to a
# plain one when it is missing. The fonts are what Arabic and emoji land on
# when the desktop font carries neither.
DEB_RECOMMENDS="libsecret-1-0, fonts-noto-color-emoji, fonts-noto-core"
RPM_RECOMMENDS="libsecret google-noto-color-emoji-fonts google-noto-sans-arabic-fonts"

# pacman reads no ELF either, so its dependencies are named as well. The Arch
# names differ from Fedora's and Debian's for most of these.
ARCH_ARCH="x86_64"
ARCH_DEPENDS="gtk3 nss nspr alsa-lib libcups libdrm mesa libxkbcommon at-spi2-core libx11 libxcomposite libxdamage libxext libxfixes libxrandr libxcursor libxinerama wayland pango cairo gdk-pixbuf2 fontconfig freetype2 expat dbus glib2 hicolor-icon-theme"
ARCH_OPTDEPENDS="libsecret: keyring-backed password store
noto-fonts-emoji: colour emoji
noto-fonts: Arabic and the scripts the desktop font does not carry"
