PKG_NAME="antigravity-update"
PKG_VERSION="1.3.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Install or update Antigravity IDE, wherever it lives"
PKG_DESCRIPTION="Discovers where Antigravity IDE is installed rather than assuming a path, and updates it in place. If it is not installed, offers to install it and asks where. Downloads resumably, verifies size and archive integrity before trusting the download, and rebuilds the desktop entry, icon and launchers afterwards so the application shows up properly in the overview. Uses sudo only when the target really needs it."
PKG_LICENSE="MIT"
PKG_SECTION="devel"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash curl jq tar rsync grep /usr/bin/awk sudo coreutils"
DEB_DEPENDS="bash, curl, jq, tar, rsync, grep, gawk | mawk, sudo, coreutils"
