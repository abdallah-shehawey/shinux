PKG_NAME="antigravity-update"
PKG_VERSION="1.1.0"
PKG_RELEASE="1"
PKG_FORMATS="rpm deb"
PKG_SUMMARY="Update a local Antigravity IDE installation"
PKG_DESCRIPTION="Compares the installed Antigravity IDE against the newest build published on the site and, when the site is ahead, downloads it resumably, verifies its size and archive integrity, and rsyncs it into place. Preserves files the IDE writes itself and restores the setuid Chromium sandbox. Use --check to ask without installing."
PKG_LICENSE="MIT"
PKG_SECTION="devel"
RPM_ARCH="noarch"
DEB_ARCH="all"
RPM_REQUIRES="bash curl jq tar rsync grep /usr/bin/awk sudo coreutils"
DEB_DEPENDS="bash, curl, jq, tar, rsync, grep, gawk | mawk, sudo, coreutils"
